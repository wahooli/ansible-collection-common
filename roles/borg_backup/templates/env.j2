# Borg Backup Configuration for {{ backup_config.name }}
BORG_REPO='{{ backup_config.repository }}'
{% if backup_config.passphrase is defined -%}
BORG_PASSPHRASE='{{ backup_config.passphrase }}'
{% else -%}
BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes
{% endif %}
BORG_ARCHIVE_NAME='{{ backup_config.archive_name | default(borg_backup_default_archive_name) }}'
BORG_BACKUP_SOURCE_DIRS='{{ backup_config.source_dirs | join(" ") }}'
BORG_CREATE_ARGS='{{ backup_config.create_args | default(borg_backup_default_create_args) }}'
BORG_PRUNE_ARGS='{{ backup_config.prune_args | default(borg_backup_default_prune_args) }}'
BORG_CHECK_ARGS='{{ backup_config.check_args | default(borg_backup_default_check_args) }}'
