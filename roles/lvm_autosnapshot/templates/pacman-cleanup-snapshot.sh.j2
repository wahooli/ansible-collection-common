#!/bin/bash

set -e

# Check if reboot is required
if /usr/local/sbin/arch-reboot-required &>/dev/null; then
    # Exit code 0 = no reboot required, safe to clean up
    echo "  -> No reboot required, removing snapshot..."
    /usr/local/sbin/remove-root-snapshot --yes
else
    # Exit code 1 = reboot required, keep snapshot
    echo "  -> Reboot REQUIRED"
    echo "  -> Snapshot can be used for rollback if needed"
    echo "  -> After successful reboot, remove manually using {{ lvm_autosnapshot_script_install_path.rstrip('/') }}/remove-root-snapshot"
fi
